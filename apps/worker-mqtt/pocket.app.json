{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.m5.worker-mqtt",
  "title": "Worker MQTT",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "runtime.worker",
        "net.mqtt",
        "system.wifi",
        "data.fs",
        "display.auxiliary",
        "input.touch.auxiliary",
        "text.glyphs.baked"
      ]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "worker-mqtt",
    "framework": "solid",
    "tickHz": 30,
    "surfaces": {
      "auxiliary": {
        "fixed": {
          "logical": [640, 360],
          "presentation": "native"
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [400, 240],
        "presentation": "native"
      }
    }
  },
  "domains": {
    "worker": {
      "entry": "worker.ts",
      "nodes": [{ "name": "mqtt", "kind": "mqtt" }],
      "channels": [
        { "name": "command", "kind": "ring", "direction": "ui-to-worker", "recordBytes": 512, "capacity": 4 },
        { "name": "status", "kind": "snapshot", "direction": "worker-to-ui", "recordBytes": 512, "capacity": 1 },
        { "name": "log", "kind": "ring", "direction": "worker-to-ui", "recordBytes": 256, "capacity": 8 }
      ]
    }
  }
}
